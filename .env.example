# Local development only. Compose overrides the database host to postgres.
DATABASE_URL=postgresql+asyncpg://support:support@127.0.0.1:5432/support
LOG_LEVEL=INFO
# Change this if another service already uses port 8000.
APP_PORT=8000
# Empty key enables the required no-key fallback mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PUBLIC_BASE_URL=http://localhost:8000
OPERATOR_USERNAME=operator
# Local demo only; set a unique password and HTTPS before a public deployment.
OPERATOR_PASSWORD=local-demo
HELPDESK_API_TOKEN=local-mock-token
# Compose origin. For local uvicorn, use ["http://127.0.0.1:8002"] instead.
ALLOWED_REPLY_ORIGINS=["http://mock-helpdesk:8000"]
