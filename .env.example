# Local development only. Compose overrides the database host to postgres.
DATABASE_URL=postgresql+asyncpg://support:support@127.0.0.1:5432/support
LOG_LEVEL=INFO
# Change this if another service already uses port 8000.
APP_PORT=8000
# Used in a later stage; empty means the required no-key fallback mode.
OPENAI_API_KEY=
OPENAI_MODEL=
